VESSEL_PORT=55300
VESSEL_BIND_ADDRESS=127.0.0.1
VESSEL_PUBLIC_URL=
PUBLIC_SERVICE_HOST=
VESSEL_BACKEND_URL=http://127.0.0.1:9100/api/v1
DOCKER_SOCKET=/var/run/docker.sock
VESSEL_BACKEND_ADDR=127.0.0.1:9100
VESSEL_SECRET_KEY=generate-a-long-random-secret
VESSEL_ADMIN_USERNAME=admin
VESSEL_ADMIN_PASSWORD=replace-with-a-strong-password
# Keep disabled unless the service is bound to 127.0.0.1. When enabled with no
# VESSEL_ADMIN_PASSWORD, a fresh local database is bootstrapped as admin/admin.
VESSEL_ALLOW_DEFAULT_ADMIN=false
VESSEL_COMPOSE_ROOT=/app/data/compose-projects
VESSEL_GIT_ROOT=/opt/vessel-data/git-sources
VESSEL_COMPOSE_HOST_ROOT=
VESSEL_DATABASE_HOST=
VESSEL_DATABASE_PORT=
